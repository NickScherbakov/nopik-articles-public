#Область ПрограммныйИнтерфейс

// Адаптер боевого режима СКД: см. NOPik/BUILD_PLAN.md, Фаза 1.
// Контракт ответа совпадает по форме с mcp-server/schemas.py::SkdReportResult
// (plan_description, rows: [{dimension, amount}], total_amount) - без слоя
// преобразования между 1С и MCP-сервером.
Функция ПолучитьОстатки(Запрос) Экспорт

    ОписаниеПлана = Запрос.ПараметрыЗапроса.Получить("plan_description");
    Если ОписаниеПлана = Неопределено Тогда
        ОписаниеПлана = "";
    КонецЕсли;

    ТаблицаОстатков = НОПик_СКД.ВыполнитьОтчетОстатков();

    Строки = Новый Массив;
    ИтогоСумма = 0;
    Для Каждого СтрокаТЗ Из ТаблицаОстатков Цикл
        Строка = Новый Структура;
        Строка.Вставить("dimension", "Номенклатура: " + СтрокаТЗ.Номенклатура);
        Строка.Вставить("amount", СтрокаТЗ.Количество);
        Строки.Добавить(Строка);
        ИтогоСумма = ИтогоСумма + СтрокаТЗ.Количество;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("plan_description", ОписаниеПлана);
    Результат.Вставить("rows", Строки);
    Результат.Вставить("total_amount", ИтогоСумма);

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Результат);
    ТелоОтвета = ЗаписьJSON.Закрыть();

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
    Возврат Ответ;

КонецФункции

#КонецОбласти