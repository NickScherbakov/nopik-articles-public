#Область ПрограммныйИнтерфейс

// Единая точка входа контракта адаптеров: любой способ доставки сообщения в
// контур 1С (объект «Бот» Системы взаимодействия, общая команда формы или,
// в будущем, любой другой адаптер) сводится к этим параметрам и здесь
// становится одинаковой асинхронной задачей отправки во внешний сервис.
//
// Параметры:
//  АвторID              - Строка - идентификатор автора сообщения в
//                          терминах адаптера-вызывающей стороны.
//  ТекстСообщения        - Строка - текст сообщения пользователя.
//  ИдентификаторОбсуждения - Строка - идентификатор диалога/треда, если
//                          у адаптера есть такое понятие (по умолчанию "").
//  ОбъектОбсуждения     - СправочникСсылка.Обсуждения / Неопределено -
//                          реальная ссылка на обсуждение, если адаптер её
//                          предоставляет - используется для доставки
//                          ответа обратно в чат. У адаптера «Команда формы»
//                          такого объекта нет: доставка ответа для него не
//                          входит в объем этой задачи, ответ только
//                          протоколируется в журнале регистрации.
Функция ПоставитьЗадачуНаОтправку(АвторID, ТекстСообщения, ИдентификаторОбсуждения = "", ОбъектОбсуждения = Неопределено) Экспорт

    КонтекстЗапроса = Новый Структура;
    КонтекстЗапроса.Вставить("MessageID",        Строка(Новый УникальныйИдентификатор));
    КонтекстЗапроса.Вставить("ConversationID",   ИдентификаторОбсуждения);
    КонтекстЗапроса.Вставить("AuthorID",         АвторID);
    КонтекстЗапроса.Вставить("Text",             ТекстСообщения);
    КонтекстЗапроса.Вставить("Timestamp",        Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"));
    КонтекстЗапроса.Вставить("TraceID",          НОПик_КлиентСервер.НовыйTraceID());
    КонтекстЗапроса.Вставить("ОбъектОбсуждения", ОбъектОбсуждения);

    // Место, куда фоновое задание положит готовый ответ. Плейсхолдер
    // размещается заранее (до старта задания), чтобы у клиента с первой же
    // секунды был адрес для опроса - ПроверитьОтвет() увидит "Готово: Ложь"
    // и продолжит ждать, а не упадет на "адрес не найден".
    АдресОтвета = ПоместитьВоВременноеХранилище(Новый Структура("Готово, Ошибка, Текст", Ложь, Ложь, ""));
    КонтекстЗапроса.Вставить("АдресОтвета", АдресОтвета);

    // Передача обработки в асинхронный фоновый контур: реальный ответ
    // nopikreport.com приходит синхронно, но за десятки секунд (замерено
    // живым вызовом - 42 сек на простом вопросе) - недопустимо ждать этого
    // в сеансе пользователя.
    //
    // Конструктору Массив нужно ЧИСЛО (размерность), а не объект - "Новый
    // Массив(КонтекстЗапроса)" падает в runtime с "Ошибка при вызове
    // конструктора" (компилятор не ловит - проверено живым запуском
    // 2026-09-17, см. BUILD_PLAN.md). Массив параметров собирается через
    // Добавить().
    ПараметрыЗадания = Новый Массив;
    ПараметрыЗадания.Добавить(КонтекстЗапроса);

    ФоновыеЗадания.Выполнить(
        "НОПик_Сеть.ОтправитьВнешнемуАгенту",
        ПараметрыЗадания,
        КонтекстЗапроса.TraceID,
        "NOPik: Запрос к nopikreport.com"
    );

    Возврат АдресОтвета;

КонецФункции

// Опрашивается клиентским таймером (см. НОПик_КлиентСервер.ОжидатьОтветНОПик)
// пока фоновое задание не положит по этому адресу готовый результат.
//
// Параметры:
//  Адрес - Строка - адрес во временном хранилище, полученный от
//          ПоставитьЗадачуНаОтправку/ОтправитьСообщениеФормыНаСервере.
//
// Возвращаемое значение:
//  Структура - поля Готово/Ошибка/Текст.
Функция ПроверитьОтвет(Адрес) Экспорт
    Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

// Обёртка контракта специально для адаптера «Команда формы».
//
// Существует ТОЛЬКО потому, что клиент не может вызвать серверную
// процедуру двухконтекстного модуля (НОПик_КлиентСервер) по имени модуля -
// платформа резолвит такой вызов к клиентскому экземпляру, где серверных
// методов нет вообще, и падает в runtime с "Метод объекта не обнаружен"
// (компилятор эту ошибку не ловит - проверено живым запуском 2026-09-17,
// см. BUILD_PLAN.md). Правильный паттерн платформы - чисто серверный
// модуль с ВызовСервера=Истина, вызываемый с клиента напрямую по имени;
// НОПик_Сеть уже был таким модулем (Клиент=Ложь), не хватало только этого
// флага и точки входа с сигнатурой, удобной для клиента.
Функция ОтправитьСообщениеФормыНаСервере(ТекстСообщения) Экспорт
    // УникальныйИдентификатор - свойство объекта ПользовательИнформационнойБазы,
    // не метод: вызов со скобками падает в runtime с "Метод объекта не
    // обнаружен" (компилятор не ловит - проверено живым запуском
    // 2026-09-17, см. BUILD_PLAN.md).
    Возврат ПоставитьЗадачуНаОтправку(
        Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор),
        ТекстСообщения,
        "form-adapter"
    );
КонецФункции

// Процедура выполняется в фоновом задании.
//
// Реальный контракт nopikreport.com (проверено живым HTTP-вызовом
// 2026-09-17, см. NOPik/BUILD_PLAN.md): POST на голый домен (без "api."
// поддомена - тот не отвечает по TLS), без ключа авторизации, синхронный
// ответ с готовым текстом за 40+ секунд, а не быстрый 202 Accepted, как
// предполагалось раньше.
Процедура ОтправитьВнешнемуАгенту(ПараметрыЗапроса) Экспорт

    СерверБэкенда = "nopikreport.com";
    Ресурс        = "/api/ask";

    ТелоЗапроса = Новый Структура;
    ТелоЗапроса.Вставить("question", ПараметрыЗапроса.Text);
    // "utmp" - реальное значение, разбирающееся backend'ом в движок
    // "1c-code-intelligence-engine" (код+руководства 1С). Любое нераспознанное
    // значение (в т.ч. использовавшееся ранее "nopi") backend молча трактует
    // как продукт по умолчанию "buh" - бухгалтерский движок, не относящийся
    // к разработке. Проверено сравнением источников ответа на один и тот же
    // вопрос при разных product (2026-09-17, см. BUILD_PLAN.md).
    ТелоЗапроса.Вставить("product",  "utmp");

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
    ТелоJSON = ЗаписьJSON.Закрыть();

    HTTPЗапрос = Новый HTTPЗапрос(Ресурс);
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    HTTPЗапрос.Заголовки.Вставить("X-Trace-ID", ПараметрыЗапроса.TraceID);
    HTTPЗапрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

    Попытка
        // Позиционные параметры: Сервер, Порт, Пользователь, Пароль,
        // ИнтернетПрокси, Таймаут, ЗащищенноеСоединение,
        // ИспользоватьАутентификациюОС - Таймаут это 6-я позиция. Первая
        // попытка (5 пустых позиций) сдвигала 90 в ЗащищенноеСоединение и
        // роняла объект OpenSSL в ИспользоватьАутентификациюОС - "Конструктор
        // не найден" (компилятор не ловит - позиционные параметры
        // типизируются только в runtime, найдено живым запуском 2026-09-17,
        // см. BUILD_PLAN.md).
        HTTPСоединение = Новый HTTPСоединение(
            СерверБэкенда,
            443,
            ,,,
            90, // Реальный замер - 42 сек на простом вопросе, запас на более сложные
            Новый ЗащищенноеСоединениеOpenSSL()
        );

        Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

        Если Ответ.КодСостояния <> 200 Тогда
            ЗаписьЖурналаРегистрации(
                "NOPik.Сеть",
                УровеньЖурналаРегистрации.Предупреждение,,,
                СтрШаблон("Ошибка бэкенда nopikreport.com. Код: %1, Ответ: %2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку())
            );
            ПоместитьВоВременноеХранилище(
                Новый Структура("Готово, Ошибка, Текст", Истина, Истина, СтрШаблон("Бэкенд вернул код %1", Ответ.КодСостояния)),
                ПараметрыЗапроса.АдресОтвета
            );
            Возврат;
        КонецЕсли;

        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        // Второй параметр (Истина) - читать JSON-объекты как Соответствие,
        // а не как Структуру (умолчание). У Структуры метода Получить(Ключ)
        // нет вообще - вызов "РезультатОтвета.Получить(...)" ниже падал в
        // runtime с "Метод объекта не обнаружен" (компилятор не ловит,
        // найдено живым запуском 2026-09-17, см. BUILD_PLAN.md).
        РезультатОтвета = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();

        ТекстОтвета = РезультатОтвета.Получить("answer");

        ЗаписьЖурналаРегистрации(
            "NOPik.Сеть",
            УровеньЖурналаРегистрации.Информация,,,
            СтрШаблон("Ответ nopikreport.com получен (tier=%1, source=%2)",
                РезультатОтвета.Получить("tier"), РезультатОтвета.Получить("source"))
        );

        ДоставитьОтветВОбсуждение(ПараметрыЗапроса, ТекстОтвета);

        ПоместитьВоВременноеХранилище(
            Новый Структура("Готово, Ошибка, Текст", Истина, Ложь, ТекстОтвета),
            ПараметрыЗапроса.АдресОтвета
        );

    Исключение
        ИнформацияОбОшибке = ИнформацияОбОшибке();
        ПоместитьВоВременноеХранилище(
            Новый Структура("Готово, Ошибка, Текст", Истина, Истина, КраткоеПредставлениеОшибки(ИнформацияОбОшибке)),
            ПараметрыЗапроса.АдресОтвета
        );
        ЗаписьЖурналаРегистрации(
            "NOPik.Сеть",
            УровеньЖурналаРегистрации.Ошибка,,,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)
        );
    КонецПопытки;

КонецПроцедуры

// Публикует готовый текст ответа обратно в чат пользователя.
//
// Работает только когда адаптер передал реальную ссылку на обсуждение
// (сегодня - адаптер «Бот»; сам объект «Бот» недоступен на этой платформе
// до 8.5.5, поэтому вызов СистемаВзаимодействия.СоздатьСообщение НЕ
// проверен живым выполнением - только компилятором). У адаптера «Команда
// формы» обсуждения нет: синхронное уведомление пользователя для него не
// входит в объем этой задачи, ответ остается только в журнале регистрации.
Процедура ДоставитьОтветВОбсуждение(ПараметрыЗапроса, ТекстОтвета)

    ОбъектОбсуждения = ПараметрыЗапроса.ОбъектОбсуждения;

    Если ОбъектОбсуждения = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ОтветСообщения = СистемаВзаимодействия.СоздатьСообщение(ОбъектОбсуждения);
    ОтветСообщения.Текст = ТекстОтвета;
    ОтветСообщения.Записать();

КонецПроцедуры

#КонецОбласти
