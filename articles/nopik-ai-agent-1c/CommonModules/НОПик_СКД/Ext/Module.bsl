#Область ПрограммныйИнтерфейс

// Выполняет реальный отчет через Систему компоновки данных (СКД) по
// остаткам товаров на складах. См. NOPik/BUILD_PLAN.md, Фаза 1 (1a) -
// боевой backend для mcp-server/tools.py::execute_skd_report.
//
// Программная схема СКД (без визуального конструктора) намеренно: код
// проверяется "Проверкой модулей" и легко переносится между базами, не
// требуя импорта отдельного макета конфигурации.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки "Номенклатура" (Строка), "Количество" (Число).
Функция ВыполнитьОтчетОстатков() Экспорт

    Схема = Новый СхемаКомпоновкиДанных;

    ИсточникДанных = Схема.ИсточникиДанных.Добавить();
    ИсточникДанных.Имя = "ИсточникДанных1";

    НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхСхемыКомпоновкиДанныхЗапрос"));
    НаборДанных.Имя = "Остатки";
    НаборДанных.ИсточникДанных = ИсточникДанных.Имя;
    НаборДанных.Запрос =
        "ВЫБРАТЬ
        |	Остатки.Номенклатура.Наименование КАК Номенклатура,
        |	Остатки.КоличествоОстаток КАК Количество
        |ИЗ
        |	РегистрНакопления.ТоварыНаСкладах.Остатки() КАК Остатки";
    НаборДанных.АвтоЗаполнениеПолей = Истина;

    НастройкиКомпоновки = Схема.НастройкиПоУмолчанию;

    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, НастройкиКомпоновки);

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

    ТаблицаРезультат = Новый ТаблицаЗначений;
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

    Возврат ТаблицаРезультат;

КонецФункции

#КонецОбласти