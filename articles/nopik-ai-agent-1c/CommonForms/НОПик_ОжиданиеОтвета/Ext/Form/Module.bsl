&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Адрес = Параметры.Адрес;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) Экспорт
    СтатусТекст = "NOPik: ожидаю ответ агента (обычно 40-60 секунд)...";
    Счетчик = 0;
    ПодключитьОбработчикОжидания("ОжидатьОтвет", 3, Истина);
КонецПроцедуры

// Таймер: раз в 3 секунды спрашивает сервер, не положило ли фоновое
// задание готовый ответ по адресу временного хранилища. Состояние
// (Адрес/Счетчик) живет как реквизит формы - в общем модуле оно жить не
// может: "Данный модуль может содержать только определения процедур и
// функций" на модульных переменных, независимо от контекста Клиент/Сервер
// (проверено живым сохранением в Конфигураторе 2026-09-18, см.
// BUILD_PLAN.md).
&НаКлиенте
Процедура ОжидатьОтвет() Экспорт

    Счетчик = Счетчик + 1;

    // 50 попыток по 3 сек = 150 сек - запас над измеренными живым вызовом
    // 40-60 секундами ответа nopikreport.com.
    Если Счетчик > 50 Тогда
        СтатусТекст = "NOPik: агент не ответил за отведенное время. Подробности - в Журнале регистрации.";
        Возврат;
    КонецЕсли;

    Результат = НОПик_Сеть.ПроверитьОтвет(Адрес);

    Если Результат = Неопределено Или Результат.Готово = Ложь Тогда
        ПодключитьОбработчикОжидания("ОжидатьОтвет", 3, Истина);
        Возврат;
    КонецЕсли;

    Если Результат.Ошибка Тогда
        СтатусТекст = "NOPik: не удалось получить ответ агента. " + Результат.Текст;
    Иначе
        СтатусТекст = "NOPik: ответ агента получен.";
        ТекстОтвета = Результат.Текст;
    КонецЕсли;

КонецПроцедуры
