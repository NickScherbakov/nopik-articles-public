// =============================================================================
// Общая форма «НОПик_ОжиданиеОтвета» — интерактивный чат с ИИ-агентом
// =============================================================================

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СтатусОтвета = "Готов к диалогу. Введите вопрос ниже.";
	ИсторияДиалога = "=== NOPik AI Ассистент ===" + Символы.ПС
		+ "Задайте вопрос по разработке, архитектуре или коду 1С." + Символы.ПС;
	ВремяСтарта = 0;
	ИдентификаторЗадания = "";
	АдресХранилища = "";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекущийЭлемент = Элементы.ТекстВопроса;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Попытка
		ОтключитьОбработчикОжидания("ПроверитьОтветАгента");
	Исключение
		// Игнорируем, если обработчик не был подключен
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	Если ПустаяСтрока(СокрЛП(ТекстВопроса)) Тогда
		Возврат;
	КонецЕсли;

	Вопрос = СокрЛП(ТекстВопроса);
	ТекстВопроса = "";

	МеткаВремени = Формат(ТекущаяДата(), "ДФ=HH:mm:ss");
	ИсторияДиалога = ИсторияДиалога + Символы.ПС
		+ "[" + МеткаВремени + "] Вы:" + Символы.ПС
		+ Вопрос + Символы.ПС;

	ВремяСтарта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СтатусОтвета = "Ожидание ответа от ИИ-агента...";
	Элементы.КнопкаОтправить.Доступность = Ложь;

	ЗапуститьОтправкуНаСервере(Вопрос);

	ПодключитьОбработчикОжидания("ПроверитьОтветАгента", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДиалог(Команда)

	ИсторияДиалога = "=== NOPik AI Ассистент ===" + Символы.ПС;
	СтатусОтвета = "История очищена. Готов к диалогу.";
	ТекущийЭлемент = Элементы.ТекстВопроса;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗапуститьОтправкуНаСервере(ТекстСообщения)

	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ДанныеЗадания = НОПик_Сеть.ЗапуститьЗадачуФормыВФоне(ТекстСообщения, АдресХранилища);
	ИдентификаторЗадания = ДанныеЗадания.IDЗадания;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтветАгента()

	Если ВремяСтарта = 0 Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтветАгента");
		Возврат;
	КонецЕсли;

	ПрошлоСекунд = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяСтарта) / 1000);
	СтатусОтвета = СтрШаблон("Ожидание ответа от ИИ-агента (прошло %1 сек)...", ПрошлоСекунд);

	Результат = ПроверитьОтветНаСервере();

	Если Результат.Готово Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтветАгента");
		Элементы.КнопкаОтправить.Доступность = Истина;
		МеткаВремени = Формат(ТекущаяДата(), "ДФ=HH:mm:ss");

		Если Результат.Ошибка Тогда
			СтатусОтвета = "Ошибка при получении ответа.";
			ИсторияДиалога = ИсторияДиалога + Символы.ПС
				+ "[" + МеткаВремени + "] [ОШИБКА]: " + Результат.Текст + Символы.ПС;
		Иначе
			СтатусОтвета = СтрШаблон("Ответ получен за %1 сек.", ПрошлоСекунд);
			ИсторияДиалога = ИсторияДиалога + Символы.ПС
				+ "[" + МеткаВремени + "] NOPik AI:" + Символы.ПС
				+ Результат.Текст + Символы.ПС;
		КонецЕсли;

		ВремяСтарта = 0;
		ИдентификаторЗадания = "";
		ТекущийЭлемент = Элементы.ТекстВопроса;

	ИначеЕсли ПрошлоСекунд > 120 Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтветАгента");
		Элементы.КнопкаОтправить.Доступность = Истина;
		СтатусОтвета = "Таймаут ожидания ответа агента (120 сек).";
		ИсторияДиалога = ИсторияДиалога + Символы.ПС
			+ "[Внимание] Превышено время ожидания ответа (120 сек). Попробуйте повторить запрос." + Символы.ПС;
		ВремяСтарта = 0;
		ИдентификаторЗадания = "";
		ТекущийЭлемент = Элементы.ТекстВопроса;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьОтветНаСервере()

	Возврат НОПик_Сеть.ПроверитьЗадачуФормы(ИдентификаторЗадания, АдресХранилища);

КонецФункции

#КонецОбласти
